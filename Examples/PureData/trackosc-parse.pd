#N canvas 100 100 1100 420 10;
#X text 20 10 trackosc-parse - receives TrackOSC on UDP 9527 and routes each message to an outlet (see README). Header on every outlet: w h n then detections.;
#X obj 20 40 netreceive -u -b 9527;
#X obj 20 70 oscparse;
#X obj 20 100 list trim;
#X obj 20 130 route camerainfo poses hands faces texts animals poses3d barcodes animalposes humans;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X obj 20 250 outlet;
#X connect 4 0 5 0;
#X text 20 280 camerainfo;
#X obj 110 190 route arr;
#X connect 4 1 7 0;
#X obj 110 250 outlet;
#X connect 7 0 8 0;
#X text 110 280 poses;
#X obj 200 190 route arr;
#X connect 4 2 10 0;
#X obj 200 250 outlet;
#X connect 10 0 11 0;
#X text 200 280 hands;
#X obj 290 190 route arr box contour;
#X connect 4 3 13 0;
#X obj 290 250 outlet;
#X connect 13 0 14 0;
#X text 290 280 faces;
#X obj 350 250 outlet;
#X connect 13 1 16 0;
#X text 350 295 faces-box;
#X obj 410 250 outlet;
#X connect 13 2 18 0;
#X text 410 280 faces-contour;
#X obj 470 190 route arr;
#X connect 4 4 20 0;
#X obj 470 250 outlet;
#X connect 20 0 21 0;
#X text 470 280 texts;
#X obj 560 190 route arr;
#X connect 4 5 23 0;
#X obj 560 250 outlet;
#X connect 23 0 24 0;
#X text 560 280 animals;
#X obj 650 190 route arr;
#X connect 4 6 26 0;
#X obj 650 250 outlet;
#X connect 26 0 27 0;
#X text 650 280 poses3d;
#X obj 740 190 route arr;
#X connect 4 7 29 0;
#X obj 740 250 outlet;
#X connect 29 0 30 0;
#X text 740 280 barcodes;
#X obj 830 190 route arr;
#X connect 4 8 32 0;
#X obj 830 250 outlet;
#X connect 32 0 33 0;
#X text 830 280 animalposes;
#X obj 920 190 route arr;
#X connect 4 9 35 0;
#X obj 920 250 outlet;
#X connect 35 0 36 0;
#X text 920 280 humans;
#X text 20 330 Outlets left to right: camerainfo poses hands faces faces-box faces-contour texts animals poses3d barcodes animalposes humans.;
#X text 20 350 Strings (text, animal labels, barcode symbology/payload) arrive as symbols inside the list.;
