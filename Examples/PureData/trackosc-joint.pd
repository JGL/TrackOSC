#X connect 14 2 17 0;
#X connect 14 1 16 0;
#X connect 14 0 15 0;
#X connect 17 0 18 2;
#X connect 16 0 18 1;
#X connect 15 0 18 0;
#X connect 18 0 19 0;
#X connect 19 0 7 1;
#X text 300 380 offset = 3 + det*(1+3*count) + 1 + 3*joint;
