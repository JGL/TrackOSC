#N canvas 100 100 620 420 10;
#X text 20 10 trackosc-joint <joint> <detection> <pointCount> - outlets: x y c (pixels) w h. c == 0 means missing.;
#X obj 20 40 inlet;
#X obj 20 70 t l l;
#X obj 300 100 list split 2;
#X obj 300 130 unpack f f;
#X obj 300 170 outlet;
#X obj 360 170 outlet;
#X connect 1 0 2 0;
#X connect 2 1 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 4 1 6 0;
#X obj 20 130 list split;
#X obj 20 160 list split 3;
#X obj 20 190 unpack f f f;
#X obj 20 230 outlet;
#X obj 80 230 outlet;
#X obj 140 230 outlet;
#X connect 2 0 7 0;
#X connect 7 1 8 0;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
#X connect 9 1 11 0;
#X connect 9 2 12 0;
#X obj 300 220 loadbang;
#X obj 300 250 t b b b;
#X obj 300 290 f \$1;
#X obj 360 290 f \$2;
#X obj 420 290 f \$3;
#X obj 300 320 pack f f f;
#X obj 300 350 expr 4 + \$f2 * (1 + 3 * \$f3) + 3 * \$f1;
