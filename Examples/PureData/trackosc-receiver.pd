#N canvas 100 100 900 620 10;
#X text 20 10 TrackOSC receiver for Pure Data (vanilla). Send from a TrackOSC sender to this machine, port 9527, or run poseiosc-testsend / trackosc_testsend.py.;
#X obj 20 50 trackosc-parse;
#X text 20 80 outlets: camerainfo poses hands faces faces-box faces-contour texts animals poses3d barcodes animalposes humans;
#X obj 600 50 tgl 15 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000 0 1;
#X text 620 50 print raw /poses/arr lists;
#X obj 600 80 spigot;
#X obj 600 110 print poses;
#X connect 3 0 5 1;
#X connect 1 1 5 0;
#X connect 5 0 6 0;
#X obj 20 130 trackosc-joint 0 0 17;
#X text 180 130 <- joint 0 (nose) of detection 0, 17 points per body;
#X connect 1 1 7 0;
#X obj 20 170 expr \$f1 / \$f2;
#X obj 120 170 expr \$f1 / \$f2;
#X connect 7 0 9 0;
#X connect 7 3 9 1;
#X connect 7 1 10 0;
#X connect 7 4 10 1;
#X text 230 170 <- normalise x by w and y by h (0..1, origin top-left);
#X obj 20 210 hsl 128 15 0 1 0 0 empty empty nose x -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 20 240 hsl 128 15 0 1 0 0 empty empty nose y -2 -8 0 10 #fcfcfc #000000 #000000 0 1;
#X connect 9 0 12 0;
#X connect 10 0 13 0;
#X floatatom 200 240 8 0 0 0 conf - - 0;
#X connect 7 2 14 0;
#X obj 20 290 expr 48 + \$f1 * 36;
#X obj 20 320 mtof;
#X obj 20 350 osc~;
#X obj 200 290 expr 0.5 - \$f1 * 0.45;
#X obj 200 320 line~;
#X obj 20 390 *~;
#X connect 9 0 15 0;
#X connect 15 0 16 0;
#X connect 16 0 17 0;
#X connect 10 0 18 0;
#X connect 18 0 19 0;
#X connect 17 0 20 0;
#X connect 19 0 20 1;
#X text 20 420 nose x -> pitch (MIDI 48..84), nose y -> loudness;
#X obj 400 130 trackosc-joint 9 0 17;
#X text 560 130 <- joint 9 (leftWrist);
#X connect 1 1 22 0;
#X obj 400 170 expr \$f1 / \$f2;
#X connect 22 1 24 0;
#X connect 22 4 24 1;
#X obj 400 210 expr 200 + (1 - \$f1) * 3800;
#X obj 400 290 noise~;
#X obj 400 320 vcf~ 800 4;
#X obj 400 360 *~ 0.1;
#X connect 24 0 25 0;
#X connect 25 0 27 1;
#X connect 26 0 27 0;
#X connect 27 0 28 0;
#X text 400 240 wrist height -> filter cutoff of a noise voice;
#X obj 20 470 dac~;
#X connect 20 0 30 0;
#X connect 20 0 30 1;
#X connect 28 0 30 0;
#X connect 28 0 30 1;
#X text 80 470 <- turn DSP on (Media > DSP On);
#X obj 600 400 unpack f f f f;
#X connect 1 0 32 0;
#X floatatom 600 440 8 0 0 0 w - - 0;
#X connect 32 0 33 0;
#X floatatom 660 440 8 0 0 0 h - - 0;
#X connect 32 1 34 0;
#X floatatom 720 440 8 0 0 0 orient - - 0;
#X connect 32 2 35 0;
#X floatatom 780 440 8 0 0 0 facing - - 0;
#X connect 32 3 36 0;
#X text 600 470 camerainfo: width height orientation facing;
#X text 20 520 Other outlets carry the same header (w h n) followed by their detections; see README.md for the layouts.;
